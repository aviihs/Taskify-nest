PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/taskify
JWT_SECRET=your-super-secret-key

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=Taskify <your-email@gmail.com>

# Recommended on Render/free hosting because SMTP ports can be blocked.
# Set EMAIL_PROVIDER=resend and provide a Resend API key.
EMAIL_PROVIDER=smtp
RESEND_API_KEY=

SMTP_CONNECTION_TIMEOUT=15000
SMTP_GREETING_TIMEOUT=15000
SMTP_SOCKET_TIMEOUT=15000
