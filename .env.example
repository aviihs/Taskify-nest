# --- Required ---
PORT=3000
# Development MUST use a local database, never production. Must be a replica set
# (transactions). Locally: mongod --replSet rs0 --dbpath <dir>, then rs.initiate() once.
# Outside NODE_ENV=production the server refuses to start if this points at a
# remote host, unless ALLOW_REMOTE_DB=true.
MONGO_URI=mongodb://127.0.0.1:27017/taskify_dev?replicaSet=rs0
# ALLOW_REMOTE_DB=true
JWT_SECRET=your-super-secret-key

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=no-reply@example.com

# --- App ---
# Public web URL used in email links (e.g. invitations)
APP_URL=http://localhost:5173
# Comma-separated allowed CORS origins; empty = reflect request origin
CORS_ORIGINS=
# Local attachment/avatar storage root
UPLOAD_DIR=./uploads

# --- AI (optional; AI endpoints return 503 when unset) ---
ANTHROPIC_API_KEY=

# --- Push notifications (optional; push is skipped when unset) ---
# Path to the Firebase service account JSON key, or the JSON itself.
# Firebase Console → Project settings → Service accounts → Generate new private key.
FIREBASE_SERVICE_ACCOUNT=
