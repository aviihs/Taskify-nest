# --- Required ---
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/taskify
JWT_SECRET=your-super-secret-key

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=no-reply@example.com

# --- App ---
# Public web URL used in email links (e.g. invitations)
APP_URL=http://localhost:5173
# Comma-separated allowed CORS origins; empty = reflect request origin
CORS_ORIGINS=
# Local attachment/avatar storage root
UPLOAD_DIR=./uploads

# --- AI (optional; AI endpoints return 503 when unset) ---
ANTHROPIC_API_KEY=
